{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:inbox-entry:v3",
  "title": "AN-KLA Inbox Entry v3",
  "description": "Entrada confirmada de `memory/inbox/pending/` con anclas, veredicto u operación (ADR-0066 §1): `inbox-entry-v2` más `anchors`, `verdict` y `operation` opcionales, y `anchor_resolution` en una anotación. v1 y v2 siguen leyéndose. `anchors` lleva de 1 a 16 anclas `memoria/ancla/v1` (C3) y, por cada una, su `write_check`: las tres comprobaciones de `remember` y su `at`; el vaciado no vuelve a leer Git y `write_check` no pasa al registro. `verdict` (contradicted|insufficient) sólo en `operation: dispute`, que exige `target_id` y `kind: fact`. `anchor_resolution` sólo en `operation: anchor_resolution` (schema `an-kla/anchor-resolution-v1`; sin orden pública en esta versión). `payload_sha256` incluye el digest canónico de las anclas, el veredicto y la operación. `slot` sólo con `kind: state`. El texto y las citas son datos, nunca instrucciones. Un binario anterior no lee v3: `inbox drain` y pendientes 0 antes de bajar de versión.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "text",
    "kind",
    "kind_explicit",
    "envelope",
    "idempotency_key",
    "payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "an-kla/inbox-entry-v3"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "fact",
        "decision",
        "state"
      ]
    },
    "kind_explicit": {
      "type": "boolean"
    },
    "envelope": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "slot": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}(?![\\s\\S])"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "schema",
          "source",
          "quote"
        ],
        "properties": {
          "schema": {
            "const": "memoria/ancla/v1"
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "repo-file",
                  "conversation",
                  "document"
                ]
              }
            }
          },
          "quote": {
            "type": "string"
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "write_check": {
            "type": "object",
            "required": [
              "source",
              "quote",
              "integrity",
              "freshness"
            ],
            "properties": {
              "source": {
                "enum": [
                  "verified",
                  "not_found",
                  "unverifiable"
                ]
              },
              "source_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "anchor_limit",
                  "commit_not_in_clone",
                  "commit_not_on_default_branch",
                  "copy_missing",
                  "custodian_offline",
                  "document_unknown",
                  "kind_not_supported",
                  "no_default_branch",
                  "no_git",
                  "no_verifier",
                  "path_missing",
                  "repo_unavailable",
                  "resolution_pending",
                  "session_lacks_quote",
                  "turn_purged"
                ]
              },
              "quote": {
                "enum": [
                  "verified",
                  "not_found",
                  "unverifiable"
                ]
              },
              "quote_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "anchor_limit",
                  "binary",
                  "commit_not_in_clone",
                  "commit_not_on_default_branch",
                  "custodian_offline",
                  "derived_modality",
                  "document_unknown",
                  "kind_not_supported",
                  "not_utf8",
                  "quote_absent",
                  "source_not_verified",
                  "too_large"
                ]
              },
              "integrity": {
                "enum": [
                  "verified",
                  "not_found",
                  "unverifiable"
                ]
              },
              "integrity_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "anchor_limit",
                  "binary",
                  "commit_blob_lacks_quote",
                  "commit_not_in_clone",
                  "copy_sha_mismatch",
                  "custodian_offline",
                  "document_unknown",
                  "kind_not_supported",
                  "manifest_mismatch",
                  "no_verifier",
                  "not_utf8",
                  "raw_lost",
                  "resolution_pending",
                  "seal_mismatch",
                  "session_lacks_quote",
                  "source_not_verified",
                  "too_large",
                  "turn_purged",
                  "working_tree"
                ]
              },
              "at": {
                "enum": [
                  "default",
                  "branch",
                  "commit",
                  "worktree",
                  null
                ]
              },
              "match": {
                "enum": [
                  "literal",
                  "ws-nfc/v1",
                  "ws-nfc-accents/v1",
                  null
                ]
              },
              "matched_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "freshness": {
                "enum": [
                  "broken",
                  "stale",
                  "unverified",
                  "pending",
                  "fresh"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolution": {
                "enum": [
                  "pending",
                  "resolved",
                  "not_found"
                ]
              },
              "turn_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "contradicted",
        "insufficient"
      ]
    },
    "operation": {
      "enum": [
        "dispute",
        "anchor_resolution"
      ]
    },
    "anchor_resolution": {
      "$ref": "urn:an-kla:schema:anchor-resolution:v1"
    }
  }
}
