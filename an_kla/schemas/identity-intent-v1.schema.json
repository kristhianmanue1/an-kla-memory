{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:identity-intent:v1",
  "title": "AN-KLA IdentityIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "project_identity", "store_identity", "current_observed", "transaction_id", "intent_sha256", "stage"],
  "properties": {
    "schema": {"const": "an-kla/identity-intent-v1"},
    "operation": {"enum": ["initialize", "adopt"]},
    "project_identity": {"$ref": "#/$defs/project"},
    "store_identity": {"$ref": "#/$defs/store"},
    "current_observed": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "transaction_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "intent_sha256": {"$ref": "#/$defs/digest"},
    "stage": {"enum": ["intent_only", "identities_ready_root_pending", "complete"]}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "initialize"}}}, "then": {"properties": {"current_observed": {"type": "null"}, "transaction_id": {"$ref": "#/$defs/uuid"}}}},
    {"if": {"properties": {"operation": {"const": "adopt"}}}, "then": {"properties": {"current_observed": {"$ref": "#/$defs/digest"}, "transaction_id": {"type": "null"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "project_uuid", "created_by_version"],
      "properties": {"schema": {"const": "an-kla/project-identity-v1"}, "project_uuid": {"$ref": "#/$defs/uuid"}, "created_by_version": {"type": "string", "minLength": 1}}
    },
    "store": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "store_uuid", "project_uuid", "project_identity", "canonical_project_root_at_init", "created_by_version"],
      "properties": {"schema": {"const": "an-kla/store-identity-v1"}, "store_uuid": {"$ref": "#/$defs/uuid"}, "project_uuid": {"$ref": "#/$defs/uuid"}, "project_identity": {"$ref": "#/$defs/digest"}, "canonical_project_root_at_init": {"type": "string", "minLength": 1}, "created_by_version": {"type": "string", "minLength": 1}}
    }
  }
}
