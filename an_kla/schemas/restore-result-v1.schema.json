{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:restore-result:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "published", "current_revision", "manifest_sha256", "warnings"],
  "oneOf": [
    {"properties": {"state": {"const": "not_published"}, "published": {"const": false}}},
    {"properties": {"state": {"const": "published"}, "published": {"const": true}}},
    {"properties": {"state": {"const": "published_durability_incomplete"}, "published": {"const": true}}},
    {"properties": {"state": {"const": "outcome_unknown"}, "published": {"const": true}}}
  ],
  "properties": {
    "schema": {"const": "an-kla/restore-result-v1"},
    "state": {"enum": ["not_published", "published", "published_durability_incomplete", "outcome_unknown"]},
    "published": {"type": "boolean"},
    "current_revision": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "warnings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(plaintext_export_contains_untrusted_memory_data|root_relocated|restore_error:.+)$"}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
