{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:write-proposal:v1",
  "title": "AN-KLA WriteProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "base_revision",
    "stream",
    "operation",
    "requested_representation",
    "record",
    "lineage"
  ],
  "properties": {
    "schema": {"const": "an-kla/write-proposal-v1"},
    "base_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stream": {
      "enum": ["facts", "events", "episodes"]
    },
    "operation": {
      "enum": ["add", "supersede", "refute", "decay"]
    },
    "requested_representation": {
      "enum": ["full", "summary"]
    },
    "supersedes": {
      "type": "string",
      "minLength": 1,
      "description": "Target record id to mark 'sustituida'. Required iff operation=supersede (co-occurrence enforced by the policy core); forbidden otherwise. Id is unique within the stream."
    },
    "record": {
      "type": "object",
      "minProperties": 1,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)|-(?:00:(?:0[1-9]|[1-5][0-9])|(?:0[1-9]|1[0-3]):[0-5][0-9]|14:00))$",
          "description": "Self-asserted last-confirmed timestamp; data, never AN-KLA authority. Calendar and UTC representability are enforced by the policy core."
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from_retrieval", "refs"],
      "properties": {
        "derived_from_retrieval": {"type": "boolean"},
        "refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["artifact", "event", "fact", "episode", "revision", "external"]
        },
        "id": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
