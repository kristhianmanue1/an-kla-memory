  "bm25":{"type":"object","additionalProperties":false,"required":["schema","name","parameters"],"properties":{"schema":{"const":"an-kla/retrieval-strategy-v1"},"name":{"const":"bm25-experiment/v1"},"parameters":{"type":"object","additionalProperties":false,"required":["tokenizer","query_terms","document_scope","k1","b","formula","score_encoding","tie_break"],"properties":{"tokenizer":{"const":"unicode-word-casefold-list/v1"},"query_terms":{"const":"distinct"},"document_scope":{"const":"eligible-requested-streams"},"k1":{"const":1.2},"b":{"const":0.75},"formula":{"const":"okapi-bm25/v1"},"score_encoding":{"const":"float-hex"},"tie_break":{"const":"score-desc-id-utf8-ascending"}}}}},
