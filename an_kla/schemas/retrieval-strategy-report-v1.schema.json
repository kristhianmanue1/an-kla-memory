  "reproducibility":{"type":"object","additionalProperties":false,"required":["cross_runtime_byte_stable","runtime_descriptor"],"properties":{"cross_runtime_byte_stable":{"type":"boolean"},"runtime_descriptor":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/runtime"}]}}},
