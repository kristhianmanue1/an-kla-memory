{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:project-identity:v1",
  "title": "AN-KLA ProjectIdentity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_uuid", "created_by_version"],
  "properties": {
    "schema": {"const": "an-kla/project-identity-v1"},
    "project_uuid": {"$ref": "#/$defs/uuid"},
    "created_by_version": {"type": "string", "minLength": 1}
  },
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}
}
