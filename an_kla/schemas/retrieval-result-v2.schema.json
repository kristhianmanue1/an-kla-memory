{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:retrieval-result:v2",
  "title": "AN-KLA RetrievalResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "requested_profile",
    "profile",
    "degradation",
    "streams_searched",
    "budget_bytes",
    "used_bytes",
    "reserved_overhead_bytes",
    "excluded_summary",
    "excluded_detail",
    "selected",
    "freshness_profile",
    "freshness"
  ],
  "properties": {
    "schema": {"const": "an-kla/retrieval-result-v2"},
    "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_profile": {"enum": ["scan-fallback/v1", "sqlite-fts5/v1"]},
    "profile": {"enum": ["scan-fallback/v1", "sqlite-fts5/v1"]},
    "degradation": {
      "enum": [
        "none",
        "fts5_unavailable",
        "index_unavailable",
        "index_unresolvable",
        "index_obsolete",
        "index_hash_mismatch",
        "index_candidate_mismatch"
      ]
    },
    "streams_searched": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["facts", "events", "episodes"]}
    },
    "budget_bytes": {"type": "integer", "minimum": 0},
    "used_bytes": {"type": "integer", "minimum": 0},
    "reserved_overhead_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed", "per_record"],
      "properties": {
        "fixed": {"type": "integer", "minimum": 0},
        "per_record": {"type": "integer", "minimum": 0}
      }
    },
    "excluded_summary": {"$ref": "#/$defs/exclusion_counts"},
    "excluded_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "truncated", "cap"],
      "properties": {
        "ids": {"$ref": "#/$defs/exclusion_ids"},
        "truncated": {"$ref": "#/$defs/exclusion_flags"},
        "cap": {"type": "integer", "minimum": 0}
      }
    },
    "selected": {
      "type": "array",
      "items": {"$ref": "#/$defs/selected_item"}
    },
    "freshness_profile": {"const": "computed-age/v1"},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "source_field", "computed_at", "stale_after_days"],
      "properties": {
        "semantics": {"const": "self_asserted_timestamp"},
        "source_field": {"const": "record.verified_at"},
        "computed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "stale_after_days": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selected": {"contains": {"required": ["stale"]}}
        }
      },
      "then": {
        "properties": {
          "freshness": {
            "properties": {
              "stale_after_days": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "exclusion_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inactive": {"type": "integer", "minimum": 1},
        "zero_score": {"type": "integer", "minimum": 1},
        "budget": {"type": "integer", "minimum": 1},
        "invalid_record": {"type": "integer", "minimum": 1},
        "no_text": {"type": "integer", "minimum": 1}
      }
    },
    "exclusion_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inactive": {"$ref": "#/$defs/id_array"},
        "zero_score": {"$ref": "#/$defs/id_array"},
        "budget": {"$ref": "#/$defs/id_array"},
        "invalid_record": {"$ref": "#/$defs/id_array"},
        "no_text": {"$ref": "#/$defs/id_array"}
      }
    },
    "exclusion_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inactive": {"type": "boolean"},
        "zero_score": {"type": "boolean"},
        "budget": {"type": "boolean"},
        "invalid_record": {"type": "boolean"},
        "no_text": {"type": "boolean"}
      }
    },
    "id_array": {
      "type": "array",
      "items": {"type": "string"}
    },
    "selected_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stream", "score", "render", "cost_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "stream": {"enum": ["facts", "events", "episodes"]},
        "score": {"type": "integer", "minimum": 1},
        "render": {"type": "string", "minLength": 1},
        "cost_bytes": {"type": "integer", "minimum": 1},
        "verified_at": {"type": "string"},
        "days_since_verified": {"type": "integer"},
        "stale": {"const": true},
        "freshness_error": {
          "enum": ["unparseable_verified_at", "unrepresentable_verified_at"]
        }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {"required": ["verified_at"]},
              {"required": ["days_since_verified"]},
              {"required": ["stale"]},
              {"required": ["freshness_error"]}
            ]
          }
        },
        {
          "required": ["verified_at", "days_since_verified"],
          "properties": {
            "verified_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)|-(?:00:(?:0[1-9]|[1-5][0-9])|(?:0[1-9]|1[0-3]):[0-5][0-9]|14:00))$"
            }
          },
          "not": {"required": ["freshness_error"]}
        },
        {
          "required": ["verified_at", "freshness_error"],
          "not": {
            "anyOf": [
              {"required": ["days_since_verified"]},
              {"required": ["stale"]}
            ]
          }
        }
      ]
    }
  }
}
