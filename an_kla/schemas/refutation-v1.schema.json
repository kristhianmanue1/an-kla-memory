{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:refutation:v1",
  "title": "AN-KLA Refutation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_revision", "stream", "target_record_sha256", "reason", "proposal_sha256", "authority_claim_sha256", "authority_attestation_id", "policy_fingerprint", "decision_sha256", "evidence_sha256", "plan_fingerprint"],
  "properties": {
    "schema": {"const": "an-kla/refutation-v1"},
    "target_revision": {"$ref": "#/$defs/digest"},
    "stream": {"enum": ["facts", "events", "episodes"]},
    "target_record_sha256": {"$ref": "#/$defs/digest"},
    "reason": {"enum": ["evidence_contradicts_record", "source_retracted", "integrity_violation"]},
    "proposal_sha256": {"$ref": "#/$defs/digest"},
    "authority_claim_sha256": {"$ref": "#/$defs/digest"},
    "authority_attestation_id": {"$ref": "#/$defs/digest"},
    "policy_fingerprint": {"$ref": "#/$defs/digest"},
    "decision_sha256": {"$ref": "#/$defs/digest"},
    "evidence_sha256": {"$ref": "#/$defs/digest"},
    "plan_fingerprint": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
