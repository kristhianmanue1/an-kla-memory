{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:refute-authority-attestation:v1",
  "title": "AN-KLA RefuteAuthorityAttestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal_sha256", "authority_claim_sha256", "base_revision", "resolver", "authority_class", "issuer", "observations_sha256", "evidence_resolutions", "scope", "proof"],
  "properties": {
    "schema": {"const": "an-kla/refute-authority-attestation-v1"},
    "proposal_sha256": {"$ref": "#/$defs/digest"},
    "authority_claim_sha256": {"$ref": "#/$defs/digest"},
    "base_revision": {"$ref": "#/$defs/digest"},
    "resolver": {"$ref": "#/$defs/descriptor"},
    "authority_class": {"enum": ["tool_observed", "channel_confirmed"]},
    "issuer": {"$ref": "#/$defs/issuer"},
    "observations_sha256": {"$ref": "#/$defs/digest"},
    "evidence_resolutions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/resolution"}},
    "scope": {"$ref": "#/$defs/scope"},
    "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9-]{0,63}/v[1-9][0-9]{0,9}$"},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["profile", "subject_sha256", "configuration_fingerprint"], "properties": {"profile": {"$ref": "#/$defs/profile"}, "subject_sha256": {"$ref": "#/$defs/digest"}, "configuration_fingerprint": {"$ref": "#/$defs/digest"}}},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["kind", "subject_sha256", "configuration_fingerprint"], "properties": {"kind": {"enum": ["tool", "channel"]}, "subject_sha256": {"$ref": "#/$defs/digest"}, "configuration_fingerprint": {"$ref": "#/$defs/digest"}}},
    "evidence": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "record_sha256"], "properties": {"kind": {"enum": ["fact", "event", "episode"]}, "record_sha256": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "revision_sha256"], "properties": {"kind": {"const": "revision"}, "revision_sha256": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "content_sha256"], "properties": {"kind": {"enum": ["artifact", "external"]}, "content_sha256": {"$ref": "#/$defs/digest"}}}
      ]
    },
    "resolution": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "record_sha256", "resolution", "observation_sha256"], "properties": {"kind": {"enum": ["fact", "event", "episode"]}, "record_sha256": {"$ref": "#/$defs/digest"}, "resolution": {"const": "verified"}, "observation_sha256": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "revision_sha256", "resolution", "observation_sha256"], "properties": {"kind": {"const": "revision"}, "revision_sha256": {"$ref": "#/$defs/digest"}, "resolution": {"const": "verified"}, "observation_sha256": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "content_sha256", "resolution", "observation_sha256"], "properties": {"kind": {"enum": ["artifact", "external"]}, "content_sha256": {"$ref": "#/$defs/digest"}, "resolution": {"const": "verified"}, "observation_sha256": {"$ref": "#/$defs/digest"}}}
      ]
    },
    "scope": {"type": "object", "additionalProperties": false, "required": ["operation", "stream", "target_record_sha256"], "properties": {"operation": {"const": "refute"}, "stream": {"enum": ["facts", "events", "episodes"]}, "target_record_sha256": {"$ref": "#/$defs/digest"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["profile", "proof_sha256"], "properties": {"profile": {"$ref": "#/$defs/profile"}, "proof_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
