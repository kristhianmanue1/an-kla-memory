{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:history-result:v2",
  "title": "AN-KLA History Result v2",
  "description": "Resultado de `history <id>` (ADR-0065 §6), sólo lectura y datos no confiables. Grafo de la revisión vigente: nodos = registros, aristas dirigidas `supersedes` (nuevo → antiguo, incluida la jubilación por casilla) y `disputes` (disputa → target). Se recorre en anchura desde `root` por las aristas en los dos sentidos, con visitados (un ciclo se recorre una vez), hasta `--limit` nodos. `nodes` va ordenado por `enqueued_at` ascendente, los legados (sin sobre válido: `enqueued_at`, `writer` y `slot` nulos) después, y por `id`; `edges` por `(from, to, type)`, y sólo con los dos extremos en `nodes`. `truncated` es true si el límite o `--budget` podaron nodos (del final del orden, con sus aristas). `used_bytes` es la longitud exacta de la salida, con su salto de línea final. ADR-0066: un nodo con anclas lleva `anchors`, `anchors_freshness` y `coverage`; con disputas con veredicto, `disputed`. La salida declara `anchor_limit`, `anchors_checked` y `anchors_unchecked` (sólo si sirvió anclas). ADR-0069: versión dispersa; sólo sale con alguna clave de ámbito o destinatario, y entonces es el superconjunto de la anterior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "untrusted_memory_data",
    "revision",
    "root",
    "nodes",
    "edges",
    "truncated",
    "used_bytes"
  ],
  "properties": {
    "schema": {
      "const": "an-kla/history-result-v2"
    },
    "untrusted_memory_data": {
      "const": true
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "stream",
          "slot",
          "writer",
          "enqueued_at",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "stream": {
            "enum": [
              "facts",
              "events",
              "episodes"
            ]
          },
          "slot": {
            "type": [
              "string",
              "null"
            ]
          },
          "writer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:an-kla:schema:record-envelope:v1#/$defs/identity"
              }
            ]
          },
          "enqueued_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "active",
              "superseded",
              "refuted"
            ]
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "anchor",
                "source",
                "source_reason",
                "quote",
                "quote_reason",
                "integrity",
                "integrity_reason",
                "match",
                "matched_text",
                "freshness",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "type": "object",
                  "required": [
                    "index",
                    "kind",
                    "quote",
                    "quote_sha256"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kind": {
                      "enum": [
                        "repo-file",
                        "conversation",
                        "document"
                      ]
                    },
                    "quote": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "quote_sha256": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "session": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "document_sha256": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "source": {
                  "enum": [
                    "verified",
                    "not_found",
                    "unverifiable"
                  ]
                },
                "source_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "anchor_limit",
                    "commit_not_in_clone",
                    "commit_not_on_default_branch",
                    "copy_missing",
                    "custodian_offline",
                    "document_unknown",
                    "kind_not_supported",
                    "no_default_branch",
                    "no_git",
                    "no_verifier",
                    "path_missing",
                    "repo_unavailable",
                    "resolution_pending",
                    "session_lacks_quote",
                    "turn_purged"
                  ]
                },
                "quote": {
                  "enum": [
                    "verified",
                    "not_found",
                    "unverifiable"
                  ]
                },
                "quote_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "anchor_limit",
                    "binary",
                    "commit_not_in_clone",
                    "commit_not_on_default_branch",
                    "custodian_offline",
                    "derived_modality",
                    "document_unknown",
                    "kind_not_supported",
                    "not_utf8",
                    "quote_absent",
                    "source_not_verified",
                    "too_large"
                  ]
                },
                "integrity": {
                  "enum": [
                    "verified",
                    "not_found",
                    "unverifiable"
                  ]
                },
                "integrity_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "anchor_limit",
                    "binary",
                    "commit_blob_lacks_quote",
                    "commit_not_in_clone",
                    "copy_sha_mismatch",
                    "custodian_offline",
                    "document_unknown",
                    "kind_not_supported",
                    "manifest_mismatch",
                    "no_verifier",
                    "not_utf8",
                    "raw_lost",
                    "resolution_pending",
                    "seal_mismatch",
                    "session_lacks_quote",
                    "source_not_verified",
                    "too_large",
                    "turn_purged",
                    "working_tree"
                  ]
                },
                "at": {
                  "enum": [
                    "default",
                    "branch",
                    "commit",
                    "worktree",
                    null
                  ]
                },
                "match": {
                  "enum": [
                    "literal",
                    "ws-nfc/v1",
                    "ws-nfc-accents/v1",
                    null
                  ]
                },
                "matched_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "freshness": {
                  "enum": [
                    "broken",
                    "stale",
                    "unverified",
                    "pending",
                    "fresh"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "resolution": {
                  "enum": [
                    "pending",
                    "resolved",
                    "not_found"
                  ]
                },
                "turn_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "anchors_freshness": {
            "enum": [
              "broken",
              "stale",
              "unverified",
              "pending",
              "fresh"
            ]
          },
          "coverage": {
            "type": "object",
            "required": [
              "total",
              "present",
              "level"
            ],
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "present": {
                "type": "integer",
                "minimum": 0
              },
              "level": {
                "enum": [
                  "none",
                  "partial",
                  "full",
                  "unchecked"
                ]
              }
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "identifier",
                    "path",
                    "version",
                    "number"
                  ]
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "missing_total": {
            "type": "integer",
            "minimum": 0
          },
          "disputed": {
            "type": "array",
            "description": "Veredicto más reciente de cada escritor sobre este registro (ADR-0066 §6); el objetivo sigue vigente. Dato no confiable.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "verdict",
                "writer",
                "enqueued_at"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "verdict": {
                  "enum": [
                    "contradicted",
                    "insufficient"
                  ]
                },
                "writer": {
                  "type": "object"
                },
                "enqueued_at": {
                  "type": "string"
                }
              }
            }
          },
          "for_reader": {
            "const": false
          },
          "subject": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "directive": {
            "$ref": "#/$defs/directive"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "supersedes",
              "disputes"
            ]
          }
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "used_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "anchor_limit": {
      "type": "integer",
      "minimum": 1
    },
    "anchors_checked": {
      "type": "integer",
      "minimum": 0
    },
    "anchors_unchecked": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actionable"
      ],
      "properties": {
        "status": {
          "enum": [
            "malformed",
            "revocation",
            "invalidated",
            "expired",
            "verified",
            "unverified"
          ]
        },
        "actionable": {
          "type": "boolean"
        },
        "subject": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "valid_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "until_revoked": {
          "const": true
        },
        "revokes": {
          "const": true
        },
        "writer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "role"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        },
        "session": {
          "type": "string"
        },
        "anchor_freshness": {
          "enum": [
            "broken",
            "stale",
            "unverified",
            "pending",
            "fresh"
          ]
        },
        "disputed": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
