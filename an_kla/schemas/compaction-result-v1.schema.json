{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:an-kla:schema:compaction-result:v1", "title": "AN-KLA Compaction Result v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "state", "committed", "candidate_revision", "current_after", "epoch_id", "plan_fingerprint", "cleanup_remaining", "outcome", "warnings"],
  "properties": {"schema": {"const": "an-kla/compaction-result-v1"}, "state": {"enum": ["not_committed", "committed_cleanup_incomplete", "committed", "outcome_unknown"]}, "committed": {"type": ["boolean", "null"]}, "candidate_revision": {"$ref": "#/$defs/digest"}, "current_after": {"$ref": "#/$defs/nullable_digest"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "plan_fingerprint": {"$ref": "#/$defs/digest"}, "cleanup_remaining": {"type": "integer", "minimum": 0}, "outcome": {"oneOf": [{"$ref": "#/$defs/outcome"}, {"type": "null"}]}, "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "nullable_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "outcome": {"type": "object", "additionalProperties": false, "required": ["schema", "transaction_id", "parent_revision", "candidate_revision", "current_observed", "candidate_relation", "state", "committed", "recorded", "authority_state", "audit_state", "durability_state", "operation_error_code", "warnings"], "properties": {"schema": {"const": "an-kla/commit-outcome-v2"}, "transaction_id": {"$ref": "#/$defs/uuid"}, "parent_revision": {"$ref": "#/$defs/nullable_digest"}, "candidate_revision": {"$ref": "#/$defs/nullable_digest"}, "current_observed": {"$ref": "#/$defs/nullable_digest"}, "candidate_relation": {"enum": ["current", "ancestor", "orphan", "unknown"]}, "state": {"enum": ["not_committed", "committed", "committed_audit_incomplete", "durability_incomplete", "outcome_unknown"]}, "committed": {"type": ["boolean", "null"]}, "recorded": {"type": ["boolean", "null"]}, "authority_state": {"enum": ["parent_lineage_authoritative", "candidate_authoritative", "unknown"]}, "audit_state": {"enum": ["not_started", "prepared", "complete", "incomplete"]}, "durability_state": {"enum": ["complete", "incomplete", "unknown"]}, "operation_error_code": {"type": ["string", "null"]}, "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}}
}
