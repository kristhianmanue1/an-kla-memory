{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:an-kla:schema:retrieval-eval-report:v2","title":"AN-KLA RetrievalEvalReport v2","type":"object","additionalProperties":false,
  "required":["schema","untrusted_memory_data","revision","corpus","configuration","query_count","rows","aggregate","parity_summary","latency"],
  "properties":{"schema":{"const":"an-kla/retrieval-eval-report-v2"},"untrusted_memory_data":{"const":true},"revision":{"$ref":"#/$defs/digest"},"corpus":{"oneOf":[{"$ref":"#/$defs/externalCorpus"},{"$ref":"#/$defs/referenceCorpus"}]},"configuration":{"$ref":"#/$defs/config"},"query_count":{"type":"integer","minimum":1},"rows":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/row"}},"aggregate":{"$ref":"#/$defs/aggregate"},"parity_summary":{"$ref":"#/$defs/paritySummary"},"latency":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/latency"}]}},
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "ratio":{"type":"object","additionalProperties":false,"required":["numerator","denominator","value"],"properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":1},"value":{"type":"number","minimum":0,"maximum":1}}},
    "score":{"type":"object","additionalProperties":false,"required":["id","score"],"properties":{"id":{"type":"string","minLength":1},"score":{"type":"integer","minimum":1}}},
    "atK":{"type":"object","additionalProperties":false,"required":["k","metric"],"properties":{"k":{"type":"integer","minimum":1},"metric":{"$ref":"#/$defs/ratio"}}},
    "excluded":{"type":"object","additionalProperties":false,"properties":{"inactive":{"type":"integer","minimum":0},"zero_score":{"type":"integer","minimum":0},"budget":{"type":"integer","minimum":0},"invalid_record":{"type":"integer","minimum":0},"no_text":{"type":"integer","minimum":0}}},
    "ranking":{"type":"object","additionalProperties":false,"required":["ranking_budget","ranked_ids","ranked_scores","precision_at_k","recall_at_k","first_relevant_rank","mrr","unretrieved_relevant"],"properties":{"ranking_budget":{"type":"integer","minimum":0},"ranked_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"ranked_scores":{"type":"array","items":{"$ref":"#/$defs/score"}},"precision_at_k":{"type":"array","items":{"$ref":"#/$defs/atK"}},"recall_at_k":{"type":"array","items":{"$ref":"#/$defs/atK"}},"first_relevant_rank":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},"mrr":{"$ref":"#/$defs/ratio"},"unretrieved_relevant":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "budget":{"type":"object","additionalProperties":false,"required":["budget_bytes","actual_profile","degradation","selected_ids","selected_scores","precision_at_budget","budget_recall","excluded_relevant_by_budget","used_bytes","excluded_summary"],"properties":{"budget_bytes":{"type":"integer","minimum":1},"actual_profile":{"enum":["scan-fallback/v1","sqlite-fts5/v1"]},"degradation":{"type":"string"},"selected_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"selected_scores":{"type":"array","items":{"$ref":"#/$defs/score"}},"precision_at_budget":{"$ref":"#/$defs/ratio"},"budget_recall":{"$ref":"#/$defs/ratio"},"excluded_relevant_by_budget":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"used_bytes":{"type":"integer","minimum":0},"excluded_summary":{"$ref":"#/$defs/excluded"}}},
    "comparison":{"type":"object","additionalProperties":false,"required":["budget_bytes","exact_selected_equal","selected_id_set_equal","common_order_equal","common_scores_equal","comparable_as_index"],"properties":{"budget_bytes":{"oneOf":[{"type":"integer","minimum":1},{"type":"null"}]},"exact_selected_equal":{"type":"boolean"},"selected_id_set_equal":{"type":"boolean"},"common_order_equal":{"type":"boolean"},"common_scores_equal":{"type":"boolean"},"comparable_as_index":{"type":"boolean"}}},
    "parity":{"type":"object","additionalProperties":false,"required":["ranking","budgets"],"properties":{"ranking":{"$ref":"#/$defs/comparison"},"budgets":{"type":"array","items":{"$ref":"#/$defs/comparison"}}}},
    "run":{"type":"object","additionalProperties":false,"required":["requested_profile","index_fixture_state","actual_profile","degradation","ranking","budgets","parity"],"properties":{"requested_profile":{"enum":["scan-fallback/v1","sqlite-fts5/v1"]},"index_fixture_state":{"enum":["not_applicable","external","absent","fresh","corrupt","stale"]},"actual_profile":{"enum":["scan-fallback/v1","sqlite-fts5/v1"]},"degradation":{"type":"string"},"ranking":{"$ref":"#/$defs/ranking"},"budgets":{"type":"array","items":{"$ref":"#/$defs/budget"}},"parity":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/parity"}]}}},
    "row":{"type":"object","additionalProperties":false,"required":["id","category","query_sha256","relevant","streams","runs"],"properties":{"id":{"type":"string","minLength":1},"category":{"enum":["synthetic","kairos_sanitized","handoff_exact"]},"query_sha256":{"$ref":"#/$defs/digest"},"relevant":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"streams":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["facts","events","episodes"]}},"runs":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/run"}}}},
    "externalCorpus":{"type":"object","additionalProperties":false,"required":["schema","revision","queries_sha256","records_sha256","corpus_sha256"],"properties":{"schema":{"const":"an-kla/external-eval-corpus-v1"},"revision":{"$ref":"#/$defs/digest"},"queries_sha256":{"$ref":"#/$defs/digest"},"records_sha256":{"$ref":"#/$defs/digest"},"corpus_sha256":{"$ref":"#/$defs/digest"}}},
    "referenceCorpus":{"type":"object","additionalProperties":false,"required":["schema","fixture_version","queries_sha256","records_sha256","fixture_sha256","corpus_sha256","provenance_manifest_sha256"],"properties":{"schema":{"const":"an-kla/reference-eval-corpus-v1"},"fixture_version":{"const":"retrieval-benchmark-v2/1"},"queries_sha256":{"$ref":"#/$defs/digest"},"records_sha256":{"$ref":"#/$defs/digest"},"fixture_sha256":{"$ref":"#/$defs/digest"},"corpus_sha256":{"$ref":"#/$defs/digest"},"provenance_manifest_sha256":{"$ref":"#/$defs/digest"}}},
    "config":{"type":"object","additionalProperties":false,"required":["schema","budgets","k_values","profiles","index_fixture_states","ranking_budget_method","config_sha256"],"properties":{"schema":{"const":"an-kla/retrieval-eval-config-v2"},"budgets":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1}},"k_values":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1}},"profiles":{"const":["scan-fallback/v1","sqlite-fts5/v1"]},"index_fixture_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["external","absent","fresh","corrupt","stale"]}},"ranking_budget_method":{"const":"eligible-record-text-utf8-sum/v1"},"config_sha256":{"$ref":"#/$defs/digest"}}},
    "macroAtK":{"type":"object","additionalProperties":false,"required":["k","value"],"properties":{"k":{"type":"integer","minimum":1},"value":{"type":"number","minimum":0,"maximum":1}}},
    "macroBudget":{"type":"object","additionalProperties":false,"required":["budget_bytes","precision_at_budget_macro","budget_recall_macro","excluded_relevant_by_budget_total"],"properties":{"budget_bytes":{"type":"integer","minimum":1},"precision_at_budget_macro":{"type":"number","minimum":0,"maximum":1},"budget_recall_macro":{"type":"number","minimum":0,"maximum":1},"excluded_relevant_by_budget_total":{"type":"integer","minimum":0}}},
    "group":{"type":"object","additionalProperties":false,"required":["profile","index_fixture_state","category","query_count","mrr_macro","precision_at_k_macro","recall_at_k_macro","budgets"],"properties":{"profile":{"enum":["scan-fallback/v1","sqlite-fts5/v1"]},"index_fixture_state":{"enum":["not_applicable","external","absent","fresh","corrupt","stale"]},"category":{"enum":["all","synthetic","kairos_sanitized","handoff_exact"]},"query_count":{"type":"integer","minimum":1},"mrr_macro":{"type":"number","minimum":0,"maximum":1},"precision_at_k_macro":{"type":"array","items":{"$ref":"#/$defs/macroAtK"}},"recall_at_k_macro":{"type":"array","items":{"$ref":"#/$defs/macroAtK"}},"budgets":{"type":"array","items":{"$ref":"#/$defs/macroBudget"}}}},
    "aggregate":{"type":"object","additionalProperties":false,"required":["groups"],"properties":{"groups":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/group"}}}},
    "counts":{"type":"object","additionalProperties":false,"required":["total","exact_matches","mismatches","actual_index","degraded"],"properties":{"total":{"type":"integer","minimum":0},"exact_matches":{"type":"integer","minimum":0},"mismatches":{"type":"integer","minimum":0},"actual_index":{"type":"integer","minimum":0},"degraded":{"type":"integer","minimum":0}}},
    "stateSummary":{"type":"object","additionalProperties":false,"required":["index_fixture_state","ranking","budgets"],"properties":{"index_fixture_state":{"enum":["external","absent","fresh","corrupt","stale"]},"ranking":{"$ref":"#/$defs/counts"},"budgets":{"$ref":"#/$defs/counts"}}},
    "paritySummary":{"type":"object","additionalProperties":false,"required":["by_state"],"properties":{"by_state":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/stateSummary"}}}},
    "latency":{"type":"object","additionalProperties":false,"required":["non_contractual","clock","warmups","samples","min_ns","median_ns","max_ns"],"properties":{"non_contractual":{"const":true},"clock":{"const":"monotonic_ns"},"warmups":{"type":"integer","minimum":0},"samples":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0}},"min_ns":{"type":"integer","minimum":0},"median_ns":{"type":"number","minimum":0},"max_ns":{"type":"integer","minimum":0}}}
  }
}
