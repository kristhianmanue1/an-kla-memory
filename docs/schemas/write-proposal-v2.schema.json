{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:write-proposal:v2",
  "title": "AN-KLA WriteProposal v2 (ADR-0054: governed batch)",
  "description": "One batch: homogeneous records (same stream and operation) evaluated against the PRE-BATCH state, with ONE decision, ONE plan, ONE revision and ONE CAS. Plan and commit with plan-write/commit-write-plan exactly as v1. The policy core also enforces what JSON Schema cannot: record ids unique within the batch (x-an-kla-unique-by), supersedes keys equal to the batch ids, no self or intra-batch supersede, unique targets, and targets current in the base snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "base_revision",
    "stream",
    "operation",
    "requested_representation",
    "records",
    "lineage"
  ],
  "properties": {
    "schema": {"const": "an-kla/write-proposal-v2"},
    "base_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stream": {
      "enum": ["facts", "events", "episodes"]
    },
    "operation": {
      "enum": ["add", "supersede"]
    },
    "requested_representation": {
      "enum": ["full", "summary"]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "x-an-kla-unique-by": "id",
      "description": "1 to max_batch_records (1000, write-policy profile) records; same shape as write-proposal-v1 record.",
      "items": {"$ref": "#/$defs/record"}
    },
    "supersedes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1},
      "description": "Map new record id -> current record id to mark 'sustituida'. Required iff operation=supersede and its keys must be exactly the batch ids; forbidden otherwise."
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from_retrieval", "refs"],
      "properties": {
        "derived_from_retrieval": {"type": "boolean"},
        "refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "supersede"}}, "required": ["operation"]},
      "then": {"required": ["supersedes"]},
      "else": {"not": {"required": ["supersedes"]}}
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "minProperties": 1,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)|-(?:00:(?:0[1-9]|[1-5][0-9])|(?:0[1-9]|1[0-3]):[0-5][0-9]|14:00))$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^an-kla:subject:v1:(?:actor|api|decision|dependency|doc|environment|integration|issue|project|service|system):p-[0-9a-f]{32}:[a-z0-9._-]{1,64}$"
        },
        "text": {"type": "string", "minLength": 1}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["artifact", "event", "fact", "episode", "revision", "external"]
        },
        "id": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
