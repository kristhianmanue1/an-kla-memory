{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:cost-certificate:v1",
  "title": "AN-KLA CostCertificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "payload_sha256",
    "canonicalization_profile",
    "cost_model_profile",
    "configuration_fingerprint",
    "cost_unit",
    "count",
    "status",
    "diagnostic_codes",
    "host_framing_measured"
  ],
  "properties": {
    "schema": {"const": "an-kla/cost-certificate-v1"},
    "payload_sha256": {"$ref": "#/$defs/digest"},
    "canonicalization_profile": {"const": "canonical-json/v1"},
    "cost_model_profile": {
      "enum": ["utf8-bytes/v1", "tokenizer-callback/v1", "external-tokenizer/v1"]
    },
    "configuration_fingerprint": {"$ref": "#/$defs/digest"},
    "cost_unit": {"enum": ["bytes", "tokens"]},
    "count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "status": {"enum": ["exact", "degraded", "unavailable"]},
    "diagnostic_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "host_framing_measured": {"type": "boolean"},
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "unavailable"}}},
      "then": {"properties": {"count": {"type": "null"}}},
      "else": {"properties": {"count": {"type": "integer", "minimum": 0}}}
    },
    {
      "if": {"properties": {"cost_unit": {"const": "tokens"}}},
      "then": {"required": ["tokenizer"]},
      "else": {"not": {"required": ["tokenizer"]}}
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
