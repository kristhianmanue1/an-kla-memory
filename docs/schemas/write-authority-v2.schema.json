{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:write-authority:v2",
  "title": "AN-KLA WriteAuthority v2 (ADR-0046: adds attestation_receipt evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_sha256",
    "base_revision",
    "authority_class",
    "issuer",
    "evidence",
    "scope"
  ],
  "properties": {
    "schema": {"const": "an-kla/write-authority-v2"},
    "proposal_sha256": {"$ref": "#/$defs/digest"},
    "base_revision": {"$ref": "#/$defs/digest"},
    "authority_class": {
      "enum": [
        "tool_observed",
        "channel_confirmed",
        "model_derived",
        "derived_from_retrieval",
        "unresolved"
      ]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "configuration_fingerprint"],
      "properties": {
        "kind": {"enum": ["tool", "channel", "model", "resolver", "unknown"]},
        "id": {"type": "string", "minLength": 1},
        "configuration_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "resolution"],
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "attestation_receipt",
              "event",
              "revision",
              "external"
            ]
          },
          "id": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["verified", "unresolved", "invalid"]},
          "sha256": {"$ref": "#/$defs/digest"}
        },
        "allOf": [
          {
            "if": {"properties": {"resolution": {"const": "verified"}}},
            "then": {"required": ["sha256"]}
          }
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streams", "representations", "operations"],
      "properties": {
        "streams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["facts", "events", "episodes"]}
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["full", "summary"]}
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["add", "supersede", "refute", "decay"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"authority_class": {"const": "tool_observed"}}},
      "then": {"properties": {"issuer": {"properties": {"kind": {"const": "tool"}}}}}
    },
    {
      "if": {"properties": {"authority_class": {"const": "channel_confirmed"}}},
      "then": {"properties": {"issuer": {"properties": {"kind": {"const": "channel"}}}}}
    },
    {
      "if": {"properties": {"authority_class": {"const": "model_derived"}}},
      "then": {"properties": {"issuer": {"properties": {"kind": {"const": "model"}}}}}
    },
    {
      "if": {"properties": {"authority_class": {"const": "derived_from_retrieval"}}},
      "then": {"properties": {"issuer": {"properties": {"kind": {"enum": ["model", "resolver"]}}}}}
    },
    {
      "if": {"properties": {"authority_class": {"const": "unresolved"}}},
      "then": {"properties": {"issuer": {"properties": {"kind": {"enum": ["unknown", "resolver"]}}}}}
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
