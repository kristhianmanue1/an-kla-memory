{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:context-assembly:v2",
  "title": "AN-KLA ContextAssembly v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "canonicalization", "untrusted_memory_data", "host_framing_unmeasured", "revision", "budget_bytes", "used_bytes", "section_provenance", "sections", "excluded_summary", "freshness_profile", "freshness"],
  "properties": {
    "schema": {"const": "an-kla/context-assembly-v2"},
    "profile": {"const": "context-assembly/v2"},
    "canonicalization": {"const": "canonical-json/v1"},
    "untrusted_memory_data": {"const": true},
    "host_framing_unmeasured": {"const": true},
    "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "budget_bytes": {"type": "integer", "minimum": 0},
    "used_bytes": {"type": "integer", "minimum": 0},
    "section_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_state", "new_information", "retrieved_records"],
      "properties": {
        "working_state": {"const": "memory_store"},
        "new_information": {"const": "caller"},
        "retrieved_records": {"const": "memory_store"}
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_state", "new_information", "retrieved_records"],
      "properties": {
        "working_state": {"type": "object"},
        "new_information": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "retrieved_records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      }
    },
    "excluded_summary": {"$ref": "#/$defs/exclusion_counts"},
    "freshness_profile": {"const": "computed-age/v1"},
    "freshness": {"$ref": "#/$defs/freshness"}
  },
  "allOf": [{"$ref": "#/$defs/stale_requires_threshold"}],
  "$defs": {
    "exclusion_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inactive": {"type": "integer", "minimum": 1},
        "zero_score": {"type": "integer", "minimum": 1},
        "budget": {"type": "integer", "minimum": 1},
        "invalid_record": {"type": "integer", "minimum": 1},
        "no_text": {"type": "integer", "minimum": 1}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "source_field", "computed_at", "stale_after_days", "evaluated", "not_evaluable", "unparseable", "stale"],
      "properties": {
        "semantics": {"const": "self_asserted_timestamp"},
        "source_field": {"const": "record.verified_at"},
        "computed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
        "stale_after_days": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "evaluated": {"type": "integer", "minimum": 0},
        "not_evaluable": {"type": "integer", "minimum": 0},
        "unparseable": {"type": "integer", "minimum": 0},
        "stale": {"type": "integer", "minimum": 0}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "score"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 1},
        "verified_at": {"type": "string"},
        "days_since_verified": {"type": "integer"},
        "stale": {"const": true},
        "freshness_error": {"enum": ["unparseable_verified_at", "unrepresentable_verified_at"]}
      },
      "oneOf": [
        {"not": {"anyOf": [{"required": ["verified_at"]}, {"required": ["days_since_verified"]}, {"required": ["stale"]}, {"required": ["freshness_error"]}]}},
        {"required": ["verified_at", "days_since_verified"], "properties": {"verified_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)|-(?:00:(?:0[1-9]|[1-5][0-9])|(?:0[1-9]|1[0-3]):[0-5][0-9]|14:00))$"}}, "not": {"required": ["freshness_error"]}},
        {"required": ["verified_at", "freshness_error"], "not": {"anyOf": [{"required": ["days_since_verified"]}, {"required": ["stale"]}]}}
      ]
    },
    "stale_requires_threshold": {
      "if": {"properties": {"sections": {"properties": {"retrieved_records": {"contains": {"required": ["stale"]}}}}}},
      "then": {"properties": {"freshness": {"properties": {"stale_after_days": {"type": "integer", "minimum": 0}}}}}
    }
  }
}
