{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:an-kla:schema:checkpoint-authority:v1","title":"AN-KLA CheckpointAuthority v1","type":"object","additionalProperties":false,
  "required":["schema","proposal_sha256","base_revision","authority_class","issuer","evidence","scope"],
  "properties":{"schema":{"const":"an-kla/checkpoint-authority-v1"},"proposal_sha256":{"$ref":"#/$defs/digest"},"base_revision":{"$ref":"#/$defs/digest"},"authority_class":{"enum":["tool_observed","channel_confirmed","model_derived","unresolved"]},"issuer":{"$ref":"#/$defs/issuer"},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"scope":{"$ref":"#/$defs/scope"}},
  "allOf":[{"if":{"properties":{"authority_class":{"const":"tool_observed"}},"required":["authority_class"]},"then":{"properties":{"issuer":{"properties":{"kind":{"const":"tool"}}}}}},{"if":{"properties":{"authority_class":{"const":"channel_confirmed"}},"required":["authority_class"]},"then":{"properties":{"issuer":{"properties":{"kind":{"const":"channel"}}}}}},{"if":{"properties":{"authority_class":{"const":"model_derived"}},"required":["authority_class"]},"then":{"properties":{"issuer":{"properties":{"kind":{"const":"model"}}}}}},{"if":{"properties":{"authority_class":{"const":"unresolved"}},"required":["authority_class"]},"then":{"properties":{"issuer":{"properties":{"kind":{"const":"unknown"}}}}}}],
  "$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"issuer":{"type":"object","additionalProperties":false,"required":["kind","id","configuration_fingerprint"],"properties":{"kind":{"enum":["tool","channel","model","unknown"]},"id":{"type":"string","minLength":1},"configuration_fingerprint":{"$ref":"#/$defs/digest"}}},"evidence":{"type":"object","additionalProperties":false,"required":["kind","id","resolution"],"properties":{"kind":{"enum":["artifact","event","revision","external"]},"id":{"type":"string","minLength":1},"resolution":{"enum":["verified","unresolved","invalid"]},"sha256":{"$ref":"#/$defs/digest"}},"allOf":[{"if":{"properties":{"resolution":{"const":"verified"}}},"then":{"required":["sha256"]}}]},"scope":{"type":"object","additionalProperties":false,"required":["operation","fields"],"properties":{"operation":{"const":"checkpoint"},"fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["objective","phase","next_step","decisions","blockers","evidence","source_state","captured_at"]},"x-an-kla-order":"utf8-bytes"}}}
}}
