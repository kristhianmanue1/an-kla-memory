{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:write-authority:v1",
  "title": "AN-KLA WriteAuthority v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_sha256",
    "base_revision",
    "authority_class",
    "issuer",
    "evidence",
    "scope"
  ],
  "properties": {
    "schema": {"const": "an-kla/write-authority-v1"},
    "proposal_sha256": {"$ref": "#/$defs/digest"},
    "base_revision": {"$ref": "#/$defs/digest"},
    "authority_class": {
      "enum": [
        "tool_observed",
        "channel_confirmed",
        "model_derived",
        "derived_from_retrieval",
        "unresolved"
      ]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "configuration_fingerprint"],
      "properties": {
        "kind": {"enum": ["tool", "channel", "model", "resolver", "unknown"]},
        "id": {"type": "string", "minLength": 1},
        "configuration_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "resolution"],
        "properties": {
          "kind": {"enum": ["artifact", "event", "revision", "external"]},
          "id": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["verified", "unresolved", "invalid"]},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streams", "representations"],
      "properties": {
        "streams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["facts", "events", "episodes"]}
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["full", "summary"]}
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
