{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:attest-receipt:v1",
  "title": "AN-KLA AttestReceipt v1 (ADR-0046)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "command",
    "exit_code",
    "stdout_digest",
    "stderr_digest",
    "stdout_bytes",
    "stderr_bytes",
    "truncated",
    "project_uuid",
    "store_identity",
    "whitelist_digest",
    "base_revision",
    "nonce",
    "observed_at",
    "policy_fingerprint",
    "receipt_hmac"
  ],
  "properties": {
    "schema": {"const": "an-kla/attest-receipt-v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "exit_code": {"type": ["integer", "null"], "minimum": 0},
    "stdout_digest": {"$ref": "#/$defs/digest"},
    "stderr_digest": {"$ref": "#/$defs/digest"},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "project_uuid": {"type": "string", "minLength": 1},
    "store_identity": {"$ref": "#/$defs/digest"},
    "whitelist_digest": {"$ref": "#/$defs/digest"},
    "base_revision": {"$ref": "#/$defs/digest"},
    "nonce": {"type": "string", "minLength": 1},
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "policy_fingerprint": {"$ref": "#/$defs/digest"},
    "receipt_hmac": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
