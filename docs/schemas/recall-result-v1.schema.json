{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:recall-result:v1",
  "title": "AN-KLA Recall Result v1",
  "description": "Resultado de `recall` (ADR-0064): hechos vigentes ordenados por BM25 sobre texto plegado y reducido a su raíz (`an-kla/lexico-es-v1`), con ámbito de repo, escritor y hora del sobre, disputas y estado de la bandeja. Datos de memoria no confiables, nunca instrucciones. `used_bytes` es la longitud exacta de la salida impresa (salto de línea final incluido) y nunca supera `budget_bytes`. `rank` es la posición en el orden total sobre todos los candidatos con puntuación mayor que cero: un hueco muestra un resultado saltado por presupuesto. `score` es BM25 redondeado a 6 decimales (el orden se decide con el valor sin redondear, después `id` ascendente). `writer` y `enqueued_at` salen del sobre sólo si es válido (afirmaciones del emisor, no prueba de autoría). `scope.repo_id` es el `repo.id` C0 del `--project-root`, o null si no se pudo derivar con `--scope all`. `inbox` informa de las escrituras comprometidas pendientes o en vuelo; es la única parte que puede cambiar sin cambio de `revision`. Enmienda 1 del ADR-0064: el orden total es puntuación exacta descendente, después `enqueued_at` del sobre válido descendente (sin sobre válido, detrás) y después `id`. Si la entrada completa de un resultado no cabe en el presupuesto, sale su stub (`truncated: true`: sin `text`, `writer` ni `disputed_by`, con `disputed` booleano en su lugar); `excluded.truncated` cuenta los stubs y `excluded.budget` sólo los candidatos que no entraron ni como stub. `query_terms` son los términos de la consulta tras el analizador, en orden; `matched_terms` los de ellos presentes en el registro. `--min-terms` excluye (`excluded.min_terms`) a los candidatos con menos términos distintos de la consulta; `no_strong_match` vale true si y sólo si había candidatos con puntuación mayor que 0 y ninguno alcanzó el umbral.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "untrusted_memory_data",
    "revision",
    "analyzer",
    "query",
    "query_terms",
    "scope",
    "streams",
    "budget_bytes",
    "used_bytes",
    "inbox",
    "excluded",
    "no_strong_match",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "an-kla/recall-result-v1"
    },
    "untrusted_memory_data": {
      "const": true
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "analyzer": {
      "const": "an-kla/lexico-es-v1"
    },
    "query": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "repo_id"
      ],
      "properties": {
        "mode": {
          "enum": [
            "repo",
            "all"
          ]
        },
        "repo_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "facts",
          "episodes"
        ]
      }
    },
    "budget_bytes": {
      "type": "integer"
    },
    "used_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "pending",
        "inflight"
      ],
      "properties": {
        "state": {
          "enum": [
            "present",
            "absent",
            "unsafe"
          ]
        },
        "pending": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inflight": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget",
        "invalid_envelope",
        "min_terms",
        "scope",
        "truncated"
      ],
      "properties": {
        "budget": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_envelope": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "integer",
          "minimum": 0
        },
        "min_terms": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "id",
              "stream",
              "score",
              "text",
              "writer",
              "enqueued_at",
              "scope_match",
              "matched_terms",
              "truncated",
              "disputed_by",
              "disputes"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stream": {
                "enum": [
                  "facts",
                  "episodes"
                ]
              },
              "score": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              },
              "writer": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "urn:an-kla:schema:record-envelope:v1#/$defs/identity"
                  }
                ]
              },
              "enqueued_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope_match": {
                "enum": [
                  "repo",
                  "legacy",
                  "other",
                  "invalid_envelope"
                ]
              },
              "disputed_by": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text",
                    "writer",
                    "enqueued_at"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string"
                    },
                    "writer": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "urn:an-kla:schema:record-envelope:v1#/$defs/identity"
                        }
                      ]
                    },
                    "enqueued_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "disputes": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stream",
                      "target_id"
                    ],
                    "properties": {
                      "stream": {
                        "enum": [
                          "facts",
                          "events",
                          "episodes"
                        ]
                      },
                      "target_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "matched_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "truncated": {
                "const": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "id",
              "stream",
              "score",
              "enqueued_at",
              "scope_match",
              "matched_terms",
              "truncated",
              "disputed"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stream": {
                "enum": [
                  "facts",
                  "episodes"
                ]
              },
              "score": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "enqueued_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope_match": {
                "enum": [
                  "repo",
                  "legacy",
                  "other",
                  "invalid_envelope"
                ]
              },
              "matched_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "truncated": {
                "const": true
              },
              "disputed": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "query_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "no_strong_match": {
      "type": "boolean"
    }
  }
}
