{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:compaction-planning-result:v1",
  "title": "AN-KLA Compaction Planning Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposal", "restore_proof", "catalog", "epoch_manifest", "candidate_manifest", "delete_set", "plan"],
  "properties": {
    "schema": {"const": "an-kla/compaction-planning-result-v1"},
    "proposal": {"$ref": "#/$defs/proposal"},
    "restore_proof": {"$ref": "#/$defs/proof"},
    "catalog": {"$ref": "#/$defs/catalog"},
    "epoch_manifest": {"$ref": "#/$defs/epoch"},
    "candidate_manifest": {"$ref": "#/$defs/candidate"},
    "delete_set": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/object_tombstone"}},
    "plan": {"$ref": "#/$defs/plan"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "closed": {"type": "object", "additionalProperties": false},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["schema", "base_revision", "epoch_id", "transaction_id", "export_manifest_sha256"], "properties": {"schema": {"const": "an-kla/compaction-proposal-v1"}, "base_revision": {"$ref": "#/$defs/digest"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "transaction_id": {"$ref": "#/$defs/uuid"}, "export_manifest_sha256": {"$ref": "#/$defs/digest"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["schema", "manifest_sha256", "inventory_sha256", "current_revision", "project_identity_sha256", "store_identity_sha256", "transaction_outcomes_sha256", "restore_result_sha256"], "properties": {"schema": {"const": "an-kla/compaction-restore-proof-v1"}, "manifest_sha256": {"$ref": "#/$defs/digest"}, "inventory_sha256": {"$ref": "#/$defs/digest"}, "current_revision": {"$ref": "#/$defs/digest"}, "project_identity_sha256": {"$ref": "#/$defs/digest"}, "store_identity_sha256": {"$ref": "#/$defs/digest"}, "transaction_outcomes_sha256": {"$ref": "#/$defs/digest"}, "restore_result_sha256": {"$ref": "#/$defs/digest"}}},
    "archived": {"type": "object", "additionalProperties": false, "required": ["revision", "epoch_id", "export_manifest_sha256"], "properties": {"revision": {"$ref": "#/$defs/digest"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "export_manifest_sha256": {"$ref": "#/$defs/digest"}}},
    "record_tombstone": {"type": "object", "additionalProperties": false, "required": ["stream", "record_sha256", "state"], "properties": {"stream": {"enum": ["facts", "events", "episodes"]}, "record_sha256": {"$ref": "#/$defs/digest"}, "state": {"enum": ["superseded", "refuted", "inactive"]}}},
    "object_tombstone": {"type": "object", "additionalProperties": false, "required": ["path", "content_sha256", "kind"], "properties": {"path": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/digest"}, "kind": {"enum": ["revision", "checkpoint", "segment", "ref-log", "transaction", "stage", "receipt", "refutation", "authority-claim", "authority-attestation", "index"]}}},
    "previous": {"type": "object", "additionalProperties": false, "required": ["epoch_id", "catalog_sha256", "export_manifest_sha256"], "properties": {"epoch_id": {"$ref": "#/$defs/uuid"}, "catalog_sha256": {"$ref": "#/$defs/digest"}, "export_manifest_sha256": {"$ref": "#/$defs/digest"}}},
    "catalog": {"type": "object", "additionalProperties": false, "required": ["schema", "epoch_id", "source_revision", "export_manifest_sha256", "delete_set_sha256", "archived_revisions", "record_tombstones", "object_tombstones", "previous_catalogs"], "properties": {"schema": {"const": "an-kla/compaction-tombstone-catalog-v1"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "source_revision": {"$ref": "#/$defs/digest"}, "export_manifest_sha256": {"$ref": "#/$defs/digest"}, "delete_set_sha256": {"$ref": "#/$defs/digest"}, "archived_revisions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/archived"}}, "record_tombstones": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/record_tombstone"}}, "object_tombstones": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/object_tombstone"}}, "previous_catalogs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/previous"}}}},
    "epoch": {"type": "object", "additionalProperties": false, "required": ["schema", "epoch_id", "transaction_id", "base_revision", "proposal_sha256", "export_manifest_sha256", "restore_proof", "tombstone_catalog", "delete_set_sha256", "compaction_policy"], "properties": {"schema": {"const": "an-kla/compaction-epoch-v1"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "transaction_id": {"$ref": "#/$defs/uuid"}, "base_revision": {"$ref": "#/$defs/digest"}, "proposal_sha256": {"$ref": "#/$defs/digest"}, "export_manifest_sha256": {"$ref": "#/$defs/digest"}, "restore_proof": {"$ref": "#/$defs/digest"}, "tombstone_catalog": {"$ref": "#/$defs/digest"}, "delete_set_sha256": {"$ref": "#/$defs/digest"}, "compaction_policy": {"$ref": "#/$defs/digest"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["schema", "revision", "parent", "facts_segments", "events_segments", "episodes_segments", "checkpoint", "transaction_id", "canonicalization", "integrity_claim", "store_identity", "features", "supersedes_map", "refutations_map", "compaction_epoch"], "properties": {"schema": {"const": "an-kla/revision-v3"}, "revision": {"type": "integer", "minimum": 1}, "parent": {"type": "null"}, "facts_segments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "events_segments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "episodes_segments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "checkpoint": {"$ref": "#/$defs/digest"}, "transaction_id": {"$ref": "#/$defs/uuid"}, "canonicalization": {"const": "canonical-json/v1"}, "integrity_claim": {"const": "content_identity_not_truth_or_authorship"}, "store_identity": {"$ref": "#/$defs/digest"}, "features": {"const": ["refutations/v1", "compaction/v1"]}, "supersedes_map": {"const": []}, "refutations_map": {"const": []}, "compaction_epoch": {"type": "object", "additionalProperties": false, "required": ["epoch_id", "source_revision", "export_manifest_sha256", "tombstone_catalog", "epoch_manifest"], "properties": {"epoch_id": {"$ref": "#/$defs/uuid"}, "source_revision": {"$ref": "#/$defs/digest"}, "export_manifest_sha256": {"$ref": "#/$defs/digest"}, "tombstone_catalog": {"$ref": "#/$defs/digest"}, "epoch_manifest": {"$ref": "#/$defs/digest"}}}}},
    "core": {"type": "object", "additionalProperties": false, "required": ["base_revision", "transaction_id", "epoch_id", "proposal_sha256", "restore_proof_sha256", "catalog_sha256", "epoch_manifest_sha256", "delete_set_sha256", "project_identity_sha256", "store_identity_sha256", "policy_fingerprint", "candidate_revision"], "properties": {"base_revision": {"$ref": "#/$defs/digest"}, "transaction_id": {"$ref": "#/$defs/uuid"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "proposal_sha256": {"$ref": "#/$defs/digest"}, "restore_proof_sha256": {"$ref": "#/$defs/digest"}, "catalog_sha256": {"$ref": "#/$defs/digest"}, "epoch_manifest_sha256": {"$ref": "#/$defs/digest"}, "delete_set_sha256": {"$ref": "#/$defs/digest"}, "project_identity_sha256": {"$ref": "#/$defs/digest"}, "store_identity_sha256": {"$ref": "#/$defs/digest"}, "policy_fingerprint": {"$ref": "#/$defs/digest"}, "candidate_revision": {"$ref": "#/$defs/digest"}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["schema", "core", "fingerprint"], "properties": {"schema": {"const": "an-kla/compaction-plan-v1"}, "core": {"$ref": "#/$defs/core"}, "fingerprint": {"$ref": "#/$defs/digest"}}}
  }
}
