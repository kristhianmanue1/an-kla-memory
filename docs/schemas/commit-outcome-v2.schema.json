{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:commit-outcome:v2",
  "title": "AN-KLA CommitOutcome v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transaction_id", "parent_revision", "candidate_revision", "current_observed", "candidate_relation", "state", "committed", "recorded", "authority_state", "audit_state", "durability_state", "operation_error_code", "warnings"],
  "properties": {
    "schema": {"const": "an-kla/commit-outcome-v2"},
    "transaction_id": {"$ref": "#/$defs/uuid"},
    "parent_revision": {"$ref": "#/$defs/nullable_digest"},
    "candidate_revision": {"$ref": "#/$defs/nullable_digest"},
    "current_observed": {"$ref": "#/$defs/nullable_digest"},
    "candidate_relation": {"enum": ["current", "ancestor", "orphan", "unknown"]},
    "state": {"enum": ["not_committed", "committed", "committed_audit_incomplete", "durability_incomplete", "outcome_unknown"]},
    "committed": {"type": ["boolean", "null"]},
    "recorded": {"type": ["boolean", "null"]},
    "authority_state": {"enum": ["parent_lineage_authoritative", "candidate_authoritative", "unknown"]},
    "audit_state": {"enum": ["not_started", "prepared", "complete", "incomplete"]},
    "durability_state": {"enum": ["complete", "incomplete", "unknown"]},
    "operation_error_code": {"type": ["string", "null"]},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate_relation": {"enum": ["current", "ancestor"]}}},
      "then": {"properties": {"committed": {"const": true}, "authority_state": {"const": "candidate_authoritative"}}}
    },
    {
      "if": {"properties": {"state": {"const": "committed"}}},
      "then": {"properties": {"committed": {"const": true}, "audit_state": {"const": "complete"}, "durability_state": {"const": "complete"}}}
    },
    {
      "if": {"properties": {"state": {"const": "committed_audit_incomplete"}}},
      "then": {"properties": {"committed": {"const": true}, "audit_state": {"const": "incomplete"}, "durability_state": {"const": "complete"}}}
    },
    {
      "if": {"properties": {"state": {"const": "durability_incomplete"}}},
      "then": {"properties": {"durability_state": {"const": "incomplete"}}}
    },
    {
      "if": {"properties": {"state": {"const": "not_committed"}}},
      "then": {"properties": {"committed": {"const": false}, "authority_state": {"const": "parent_lineage_authoritative"}}}
    },
    {
      "if": {"properties": {"state": {"const": "outcome_unknown"}}},
      "then": {"properties": {"committed": {"type": "null"}, "authority_state": {"const": "unknown"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
