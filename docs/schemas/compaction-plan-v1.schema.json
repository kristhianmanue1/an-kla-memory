{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:an-kla:schema:compaction-plan:v1", "title": "AN-KLA Compaction Plan v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "core", "fingerprint"], "properties": {"schema": {"const": "an-kla/compaction-plan-v1"}, "fingerprint": {"$ref": "#/$defs/digest"}, "core": {"type": "object", "additionalProperties": false, "required": ["base_revision", "transaction_id", "epoch_id", "proposal_sha256", "restore_proof_sha256", "catalog_sha256", "epoch_manifest_sha256", "delete_set_sha256", "project_identity_sha256", "store_identity_sha256", "policy_fingerprint", "candidate_revision"], "properties": {"base_revision": {"$ref": "#/$defs/digest"}, "transaction_id": {"$ref": "#/$defs/uuid"}, "epoch_id": {"$ref": "#/$defs/uuid"}, "proposal_sha256": {"$ref": "#/$defs/digest"}, "restore_proof_sha256": {"$ref": "#/$defs/digest"}, "catalog_sha256": {"$ref": "#/$defs/digest"}, "epoch_manifest_sha256": {"$ref": "#/$defs/digest"}, "delete_set_sha256": {"$ref": "#/$defs/digest"}, "project_identity_sha256": {"$ref": "#/$defs/digest"}, "store_identity_sha256": {"$ref": "#/$defs/digest"}, "policy_fingerprint": {"$ref": "#/$defs/digest"}, "candidate_revision": {"$ref": "#/$defs/digest"}}}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}
}
