{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:record-envelope:v1",
  "title": "AN-KLA Record Envelope v1",
  "description": "Reserved key `an_kla_envelope` of a record (ADR-0063 D2): writer identity C0 `memoria/identidad/v1`, enqueue time and idempotency key. Structural check only: the C0 validator is authoritative for what a schema cannot express (`session.id` prefix equal to `agent.cli`, calendar validity of `enqueued_at`). The envelope is an assertion by the emitter, stored as given.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "writer", "enqueued_at", "time_source", "idempotency_key", "kind"],
  "properties": {
    "schema": {"const": "an-kla/record-envelope-v1"},
    "writer": {"$ref": "#/$defs/identity"},
    "enqueued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "time_source": {"const": "host-clock/v1"},
    "idempotency_key": {"$ref": "#/$defs/digest"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ident": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "repo", "agent", "session"],
      "properties": {
        "schema": {"const": "memoria/identidad/v1"},
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"$ref": "#/$defs/repo_id"},
            "branch": {"$ref": "#/$defs/branch"}
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "cli", "model", "role"],
          "properties": {
            "name": {"allOf": [{"$ref": "#/$defs/ident"}, {"not": {"enum": ["desconocido", "sin-sesion"]}}]},
            "cli": {"$ref": "#/$defs/ident"},
            "model": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"},
            "role": {"enum": ["operador", "orquestador", "capitan", "ejecutor", "revisor", "desconocido"]}
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:\\S{1,200}$"}
          }
        }
      }
    },
    "repo_id": {
      "anyOf": [
        {"type": "string", "pattern": "^(?:local|remoto):[0-9a-f]{16}$"},
        {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/(?:[a-z0-9._~-]+/)*[a-z0-9._~-]+$",
          "allOf": [
            {"not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}},
            {"not": {"pattern": "\\.git$"}}
          ]
        }
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s~^:?*\\[\\\\]+$",
      "allOf": [
        {"not": {"pattern": "^(?:HEAD$|[-/.]|refs/)"}},
        {"not": {"pattern": "(?:[/.]|\\.lock)$"}},
        {"not": {"pattern": "\\.\\.|//|@\\{|/\\."}}
      ]
    }
  }
}
