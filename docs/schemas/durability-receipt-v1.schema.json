{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-kla:schema:durability-receipt:v1",
  "title": "AN-KLA DurabilityReceipt v1",
  "description": "protected is additionally validated for canonical byte ordering, unique path+operation pairs, safe relative NFC paths, required artifact coverage, and content hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "transaction_id", "execution_fingerprint", "candidate_revision", "predecessor_receipt", "repair_for_kind", "protected"],
  "properties": {
    "schema": {"const": "an-kla/durability-receipt-v1"},
    "kind": {"enum": ["candidate-data-durable", "current-durable", "repair"]},
    "transaction_id": {"$ref": "#/$defs/uuid"},
    "execution_fingerprint": {"$ref": "#/$defs/digest"},
    "candidate_revision": {"$ref": "#/$defs/digest"},
    "predecessor_receipt": {"$ref": "#/$defs/nullable_digest"},
    "repair_for_kind": {"oneOf": [{"enum": ["candidate-data-durable", "current-durable"]}, {"type": "null"}]},
    "protected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation", "content_sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/safe_path"},
              "operation": {"const": "file_fsync"},
              "content_sha256": {"$ref": "#/$defs/digest"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation", "content_sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/safe_path"},
              "operation": {"const": "directory_fsync"},
              "content_sha256": {"type": "null"}
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "candidate-data-durable"}}},
      "then": {"properties": {"predecessor_receipt": {"type": "null"}, "repair_for_kind": {"type": "null"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "current-durable"}}},
      "then": {"properties": {"predecessor_receipt": {"$ref": "#/$defs/digest"}, "repair_for_kind": {"type": "null"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "repair"}}},
      "then": {"properties": {"repair_for_kind": {"enum": ["candidate-data-durable", "current-durable"]}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "safe_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
